# Copy this file to `.env` and adjust values for local development.
# Never commit `.env` or real credentials.

# Docker Compose PostgreSQL service
# Host port 5433 avoids colliding with a local PostgreSQL on 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=matrixcosec
POSTGRES_USER=matrixcosec
POSTGRES_PASSWORD=change-me

# Rust / SQLx connection string. Keep in sync with the POSTGRES_* values above.
DATABASE_URL=postgres://matrixcosec:change-me@127.0.0.1:5433/matrixcosec

# Optional logging. JSON logs are emitted by the Rust process.
# RUST_LOG=info,sqlx=warn
