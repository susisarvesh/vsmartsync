# Copy this file to `.env` and adjust values for local development.
# Never commit `.env` or real credentials.
#
# PostgreSQL runs as a normal local install on this machine (not Docker).
# Default port is 5432.

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vsmart_sync
POSTGRES_USER=vsmart_sync
POSTGRES_PASSWORD=change-me

# Rust / SQLx connection string. Keep in sync with the POSTGRES_* values above.
DATABASE_URL=postgres://vsmart_sync:change-me@127.0.0.1:5432/vsmart_sync

# Ignored PostgreSQL tests refuse DATABASE_URL. Create a separate database
# (for example `CREATE DATABASE vsmart_sync_test`) and set this before
# `cargo test -- --ignored`. The name must end with `_test`.
# TEST_DATABASE_URL=postgres://vsmart_sync:change-me@127.0.0.1:5432/vsmart_sync_test

# Optional logging. JSON logs are emitted by the Rust process.
# RUST_LOG=info,sqlx=warn

# How many readers to contact at once. Default 4. Allowed 1–40.
# 40 is accepted, but it is not the recommended setting on a local database.
# The registered-device list is a separate limit.
# VSMART_POLL_CONCURRENCY=4

# Seconds from the start of one poll cycle to the start of the next.
# A cycle that already ran longer than this starts the next pass immediately.
# Allowed 5–3600. Default 30.
# VSMART_POLL_INTERVAL_SECS=30
